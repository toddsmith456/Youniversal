<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-API-26 launcher icon: one self-contained vector (no binary assets in the repo).
  API 26+ resolves the adaptive icon in mipmap-anydpi-v26 instead.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M24,0 L84,0 A24,24 0 0 1 108,24 L108,84 A24,24 0 0 1 84,108 L24,108 A24,24 0 0 1 0,84 L0,24 A24,24 0 0 1 24,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endColor="@color/ic_launcher_background_end"
                android:endX="108"
                android:endY="108"
                android:startColor="@color/ic_launcher_background_start"
                android:startX="0"
                android:startY="0"
                android:type="linear" />
        </aapt:attr>
    </path>

    <path
        android:pathData="M36,34 L54,58 L72,34"
        android:strokeColor="@color/ic_launcher_mark"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="9" />
    <path
        android:pathData="M54,58 L54,80"
        android:strokeColor="@color/ic_launcher_mark"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="9" />
</vector>
